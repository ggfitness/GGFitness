# ============================================================
#  Solo se sube a GitHub lo que Vercel necesita para el deploy.
# ============================================================

# Dependencias (Vercel las instala solas)
node_modules

# Secretos y configuración local (las variables van en el panel de Vercel)
.env
.env.local
.env.*.local

# Credenciales de Google Cloud (el JSON de la cuenta de servicio).
# NUNCA se sube: va en la variable GOOGLE_SERVICE_ACCOUNT_JSON.
*service-account*.json
*service_account*.json
*-credentials.json
credentials.json
gcp-*.json
client_secret*.json

# Órdenes guardadas en local (en producción van a Upstash Redis)
data

# Logs, temporales y capturas de pantalla
*.log
*.tmp
/*.png

# Carpeta interna de Vercel
.vercel

# Documentación y notas: solo va el README, ningún otro .md
*.md
!README.md

# Basura del sistema operativo
.DS_Store
Thumbs.db
