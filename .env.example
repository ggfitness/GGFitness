# ==========================================================================
# Copiá este archivo como .env  ->  cp .env.example .env
# Con estos valores por defecto la web YA FUNCIONA en modo DEMO
# (simula el pago aprobado y muestra los mails en la consola).
# ==========================================================================

# URL pública de la web (en local dejalo así; en Vercel poné tu dominio)
BASE_URL=http://localhost:3000
PORT=3000

# ---- Personal Trainer ----
# Mail de la trainer donde le llegan los avisos de venta
TRAINER_EMAIL=trainer@ejemplo.com

# WhatsApp para el botón "Consultar por WhatsApp" de los planes personalizados.
# Solo dígitos, con código de país y sin + ni espacios (ej: 5491122334455).
# Si lo dejás vacío, el botón NO se muestra (no queda un link roto).
WHATSAPP_NUMBER=5491150014078

# ==========================================================================
#  MERCADO PAGO
# ==========================================================================
#  Paso a paso completo (qué pedirle a la clienta y dónde se saca): MERCADOPAGO.md
#
#  Para verificar que quedó bien conectado, sin mirar logs:
#    GET https://tu-dominio/api/admin/estado?token=<ADMIN_TOKEN>

# --- 1) Access Token (OBLIGATORIO para cobrar) ---
# Si lo dejás vacío, la web funciona en MODO DEMO (pago simulado).
# Dónde está: https://www.mercadopago.com.ar/developers/panel/app
#   > tu aplicación > Credenciales de producción > Access Token
#
# ⚠️ NO es la Public Key. Las dos empiezan con "APP_USR-", pero la Public Key es
# corta (un UUID) y el Access Token es largo. Si se pega la equivocada, el
# servidor lo detecta al arrancar y avisa en los logs.
#
# ⚠️ EN EL SITIO PUBLICADO ESTA VARIABLE ES OBLIGATORIA. Sin ella el pago no se
# verifica contra nadie y cualquiera podría confirmar una orden sin pagar y
# llevarse el material. Por eso, si falta en un deploy de Vercel, el checkout
# queda BLOQUEADO a propósito (la web se ve, pero no vende).
#
# Para PROBAR sin cobrar de verdad se puede usar el Access Token de prueba
# (empieza con "TEST-"): el flujo funciona completo pero no entra plata. El
# servidor avisa fuerte si detecta credenciales de prueba en un sitio público.
MP_ACCESS_TOKEN=

# --- 2) Clave secreta del webhook (MUY recomendada) ---
# Confirma que las notificaciones de pago las manda Mercado Pago y no un tercero.
# Dónde está: panel de MP > Tus integraciones > tu app > Webhooks > Clave secreta.
# Si la dejás vacía no se rompe nada: el pago igual se re-consulta contra la API
# de MP antes de entregar el material, pero conviene cargarla.
MP_WEBHOOK_SECRET=

# --- 3) Moneda de la cuenta (opcional) ---
# Una cuenta de Mercado Pago cobra en la moneda de su país. Si un producto
# estuviera en otra moneda, el checkout se bloquea en vez de cobrar mal.
# ARS (Argentina), MXN, BRL, CLP, COP, PEN, UYU.
MP_CURRENCY=ARS

# --- 4) Ajustes finos (opcionales, los valores por defecto están bien) ---
# Texto que ve el comprador en el resumen de su tarjeta (máx. 22 caracteres,
# solo letras y números). Si se deja vacío se usa BRAND_NAME.
MP_STATEMENT_DESCRIPTOR=

# Horas que vive el link de pago antes de vencer. Evita que alguien pague la
# semana que viene un link generado con los precios de hoy. 0 = nunca vence.
MP_PREFERENCE_EXPIRY_HOURS=24

# true = solo se aceptan pagos aprobados al instante (tarjeta, dinero en cuenta)
# y se pierde el pago en efectivo (Rapipago/Pago Fácil), que acredita después.
# Dejalo en false salvo que no quieras cobros diferidos.
MP_BINARY_MODE=false

# --- 5) Comisión, para estimar el neto de cada venta (opcional) ---
# La comisión que Mercado Pago le cobra a la cuenta, en porcentaje.
#
# ⚠️ EL NÚMERO REAL SALE DEL PANEL DE LA CLIENTA: Tu negocio > Costos.
# Depende del plazo de acreditación que eligió (cobrar al instante cuesta casi
# el doble que cobrar a 30 días) y cambia con el tiempo.
#
# Para qué sirve cargarla:
#   - El aviso de venta a la trainer dice cuánto le queda neto, no solo el total.
#   - `npm run precios` calcula el neto de cada producto y de cada combo, y a
#     qué precio hay que vender para llevarse un número exacto.
#
# Si la dejás vacía no se muestra ningún neto en ninguna parte (preferimos no
# decir nada antes que mostrar un número inventado). Ejemplo: 6.29
MP_FEE_PERCENT=

# IVA que Mercado Pago cobra SOBRE la comisión (no sobre la venta).
# En Argentina es 21. Solo cambialo si la cuenta es de otro país.
MP_FEE_IVA_PERCENT=21

# ==========================================================================
#  PANEL DE DIAGNÓSTICO (opcional pero recomendado)
# ==========================================================================
# Habilita GET /api/admin/estado?token=... , que dice qué está configurado y qué
# falta (Mercado Pago, mails, base de datos, Drive) SIN mostrar ningún secreto.
# Si lo dejás vacío, el endpoint no existe.
# Poné una cadena larga y al azar, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# ==========================================================================
#  ENVÍO DE MAILS — elegí UNA opción (o dejá todo vacío para modo demo)
# ==========================================================================

# --- Opción A (recomendada en Vercel): Resend ---
# Sacá tu API key en https://resend.com  (free: 3.000 mails/mes)
RESEND_API_KEY=
# Remitente. Para usar tu dominio, verificalo antes en Resend.
# Para probar sin dominio podés usar: onboarding@resend.dev
MAIL_FROM=GG <onboarding@resend.dev>

# --- Opción B: SMTP (Gmail, etc.) ---
# Con Gmail usá una "contraseña de aplicación", no la normal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Personal Trainer <no-reply@ejemplo.com>

# ==========================================================================
#  ENTREGA AUTOMÁTICA DEL MATERIAL (Google Drive)
# ==========================================================================
# Cómo funciona: las carpetas de los packs quedan PRIVADAS en Drive y, cuando
# se aprueba un pago, el servidor le da acceso de lectura al mail del comprador.
# El link no sirve si lo reenvía: solo entra la cuenta que compró.
# Si dejás esto vacío, no se rompe nada: todo pasa a entrega manual y la
# trainer recibe el aviso.
#
# Paso a paso completo: ver DRIVE-SETUP.md

# 1) El JSON de la cuenta de servicio de Google Cloud, EN BASE64 (una sola línea).
#    Generalo así (PowerShell, desde donde tengas el archivo):
#      [Convert]::ToBase64String([IO.File]::ReadAllBytes("clave.json"))
#    O en Git Bash / Linux / Mac:
#      base64 -w0 clave.json
#    También se acepta el JSON pegado tal cual, pero en base64 no se rompe nunca.
#    ⚠️ ESTA VARIABLE ES UNA CONTRASEÑA: no la pegues en chats ni la commitees.
GOOGLE_SERVICE_ACCOUNT_JSON=

# 2) Qué carpeta de Drive corresponde a cada producto (JSON en una línea).
#    Se acepta el ID o el link completo copiado del navegador.
#    Los ids de producto son los de src/products.js.
#    Un producto que NO esté acá = servicio a medida (lo coordina la trainer).
DRIVE_FOLDERS={"pack-mentalidad":"","pack-recetas-fit":"","pack-rutinas-tren-inferior":"","pack-rutinas-tren-superior":""}

# 3) (Opcional) Mail de la cuenta de Google que es DUEÑA de las carpetas.
#    Solo informativo: sirve para saber desde qué cuenta compartir si algo falla.
DRIVE_OWNER_EMAIL=

# ==========================================================================
#  BASE DE DATOS DE ÓRDENES
# ==========================================================================
# En LOCAL/Docker no hace falta nada: se usa data/orders.json.
# En VERCEL agregás Upstash Redis (free) y estas variables se completan solas
# al conectar la integración. Nombres soportados:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (Vercel KV también funciona: KV_REST_API_URL / KV_REST_API_TOKEN)
